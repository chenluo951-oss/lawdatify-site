<style>
:root{
  --navy:#1F3B63; --navy2:#2E5E8C; --blue:#3A6B8F;
  --ink:#2B2B2B; --gray:#6B7280; --lgray:#9AA3AF;
  --red:#A93B33; --orange:#B0652C; --amber:#B0862E; --green:#4C7A59;
