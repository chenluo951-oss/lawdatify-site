# 融合脚本必须入仓：GitHub Actions 云端重建站点时要调用
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 桌面部署包不应出现在仓库
*.zip

# 本地运行时产物与字体（不入仓）
out/
.fonts/

# EdgeOne 部署工具产物（含整站副本，不入仓）
.edgeone/

# 环境变量（防止误提交密钥）
.env
.env.*

# 站点只发布网页版：简报 PDF/Word 保留本机，不上传（用户 2026-09-08 决定）
news/reports/*.pdf
news/reports/*.docx
*.pdf
*.docx

# 例外：标准原版 PDF 直读（用户 2026-09-14 要求标准正文直接用 PDF、不再靠 OCR）
!kb/std/*.pdf

# 含编造链接、待复核的报告（隔离区，不发布）
_quarantine/

# 误建目录兜底：曾出现名字里带引号的 `"news` 目录（脚本把 git ls-files 的带引号输出
# 当真路径写盘所致，12 个乱码名 HTML），已清理。这里加护栏，保证即便再被误建也不会进仓/上线。
"news/

# 非公开页面（仅本人本机可见，不上传站点）
_private/

# 原文语料库：只存本机，不上传（标准正文受版权保护，站点仅放元数据+章节）
sources/library/corpus/

# 抓取工作清单缓存（可随时重建，不入仓）
sources/standards/harvest_worklist.json

# 国标在线预览的整页截图与 OCR 中间产物（标准正文受版权保护，只留本机 + 私有库）
sources/scans/

# 标准 PDF 文字层抽取缓存（可随时重抽，不入仓）
sources/.cache/

# 无头渲染自检的临时探针页（每次自检重新生成，不入仓）
kb/_probe.html
tools/_diag.py

# 法规全文抓取库（flk）
# ⚠️ texts.jsonl 是本机累积的原文抓取库，随抓取持续增长（实测已 32MB）。
# GitHub 建 blob 对单文件体积敏感，超过上限时**只返回 {'_err': ''} 不报错**，
# 静默失败会留下「远端长期停在旧版本」的隐患（曾表现为 texts.jsonl 一直推不上去）。
# 站内可用形态是生成物 kb/texts/*.html（照常入仓），故本文件不入仓。
sources/flk_texts/texts.jsonl
# WAF 会话 cookie 与抓取中间产物（临时、含凭据，绝不入仓）
sources/flk_texts/.wzws_*
sources/flk_texts/.tmp/

# 日期回填的页面探测缓存（可重建，含全量 URL → PubDate 映射，无需入库）
sources/appviol/.dateprobe.json
# apps.json 是 docs.json 的派生产物（实体消解 + 事件模型的结果，~4MB 且随数据增长），
# 页面实际消费的是 analytics.json；需要时用 `harvest_app_violations.py --apps-only` 秒级重算。
# ⚠️ Git Data API 建 blob 单文件 >6MB 会静默失败（只报 _err:''），4MB 已逼近红线。
sources/appviol/apps.json

# 案例库全文缓存（仅本机用于重算「处罚事由 / 处罚」，体积大、不入仓、不上线）
_qa/case_full.jsonl
_qa/amr_backlog.log
_qa/refresh_text.log
_qa/backlog_finish.log
_qa/backlog_harvest.log
