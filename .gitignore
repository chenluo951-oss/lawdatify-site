# 融合脚本必须入仓：GitHub Actions 云端重建站点时要调用
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 桌面部署包不应出现在仓库
*.zip

# 本地运行时产物与字体（不入仓）
out/
.fonts/

# EdgeOne 部署工具产物（含整站副本，不入仓）
.edgeone/

# 环境变量（防止误提交密钥）
.env
.env.*

# 站点只发布网页版：PDF/Word 保留本机，不上传（用户 2026-09-08 决定）
news/reports/*.pdf
news/reports/*.docx
*.pdf
*.docx

# 含编造链接、待复核的报告（隔离区，不发布）
_quarantine/

# 非公开页面（仅本人本机可见，不上传站点）
_private/

# 原文语料库：只存本机，不上传（标准正文受版权保护，站点仅放元数据+章节）
sources/library/corpus/

# 抓取工作清单缓存（可随时重建，不入仓）
sources/standards/harvest_worklist.json

# 国标在线预览的整页截图与 OCR 中间产物（标准正文受版权保护，只留本机 + 私有库）
sources/scans/

# 标准 PDF 文字层抽取缓存（可随时重抽，不入仓）
sources/.cache/

# 无头渲染自检的临时探针页（每次自检重新生成，不入仓）
kb/_probe.html
tools/_diag.py
