# 融合脚本必须入仓：GitHub Actions 云端重建站点时要调用
__pycache__/
*.pyc

# 系统文件
.DS_Store

# 桌面部署包不应出现在仓库
*.zip

# 本地运行时产物与字体（不入仓）
out/
.fonts/

# EdgeOne 部署工具产物（含整站副本，不入仓）
.edgeone/

# 环境变量（防止误提交密钥）
.env
.env.*

# 站点只发布网页版：PDF/Word 保留本机，不上传（用户 2026-09-08 决定）
news/reports/*.pdf
news/reports/*.docx
*.pdf
*.docx

# 含编造链接、待复核的报告（隔离区，不发布）
_quarantine/

# 非公开页面（仅本人本机可见，不上传站点）
_private/
