 "duties": [
  {
   "name": "告知同意",
   "topic": "个人信息保护",
   "desc": "处理前以显著方式、清晰易懂语言真实准确完整告知，并取得自愿明确同意；变更须重新取得同意。"
  },
  {
   "name": "最小必要",
   "topic": "个人信息保护",
   "desc": "收集限于实现处理目的的最小范围，不得一揽子授权；权限动态申请、拒绝后不得影响基本功能。"
  },
  {
   "name": "敏感个人信息",
   "topic": "个人信息保护",
   "desc": "单独同意、必要性说明、影响告知；生物识别、医疗健康、金融账户、行踪轨迹及不满十四周岁未成年人信息。"
  },
  {
   "name": "未成年人个人信息",
   "topic": "个人信息保护",
   "desc": "专门处理规则、监护人同意、年龄分层措施，防沉迷与防欺凌要求。"
  },
  {
   "name": "个人权利响应",
   "topic": "个人信息保护",
   "desc": "查阅、复制、更正、补充、删除、撤回同意、注销、转移等请求的受理机制与 15 个工作日时限。"
  },
  {
   "name": "个人信息保护影响评估",
   "topic": "个人信息保护",
   "desc": "处理敏感信息、自动化决策、委托处理/对外提供/公开、跨境提供、其他重大影响情形前应开展 PIA 并留存三年。"
  },
  {
   "name": "委托与共同处理",
   "topic": "个人信息保护",
   "desc": "约定处理目的、方式、种类、保护措施与权利义务，监督受托方，记录处理情况。"
  },
  {
   "name": "第三方共享",
   "topic": "个人信息保护",
   "desc": "向第三方提供须单独同意、共享清单公示、签署协议并监督；SDK 纳入同等管理。"
  },
  {
   "name": "个人信息保护合规审计",
   "topic": "个人信息保护",
   "desc": "定期审计处理活动合法性；处理超 1000 万人信息者每两年至少一次，可由内部或外部机构执行。"
  },
  {
   "name": "内部管理制度",
   "topic": "个人信息保护",
   "desc": "分类管理、权限审批、教育培训、应急预案、负责人制度与履职记录。"
  },
  {
   "name": "数据分类分级",
   "topic": "数据安全",
   "desc": "建立分类分级制度与目录，识别重要数据并按级采取保护措施。"
  },
  {
   "name": "重要数据保护",
   "topic": "数据安全",
   "desc": "识别申报、风险评估、出境管制，重要数据处理者应设数据安全负责人与管理机构。"
  },
  {
   "name": "数据安全风险评估",
   "topic": "数据安全",
   "desc": "定期开展并向主管部门报送；重要数据与大规模个人信息处理活动为高频触发场景。"
  },
  {
   "name": "数据出境",
   "topic": "数据跨境",
   "desc": "安全评估、标准合同、保护认证三条路径的适用条件与申报流程，有效期届满需重新申报。"
  },
  {
   "name": "网络安全等级保护",
   "topic": "网络安全",
   "desc": "定级备案、建设整改、等级测评、监督检查；二级以上系统需定期测评。"
  },
  {
   "name": "安全事件应急处置",
   "topic": "网络安全",
   "desc": "应急预案、演练、事件报告（个人信息泄露须通知个人与主管部门）、处置记录留存。"
  },
  {
   "name": "网络安全漏洞管理",
   "topic": "网络安全",
   "desc": "漏洞发现、验证、修补、发布与报送机制，不得违规发布或使用漏洞。"
  },
  {
   "name": "关键信息基础设施",
   "topic": "网络安全",
   "desc": "识别认定、安全防护、检测评估、采购审查与年度检查。"
  },
  {
   "name": "算法备案与公示",
   "topic": "算法与AI合规",
   "desc": "算法推荐、深度合成、生成式 AI 服务均须备案并公示算法基本原理与目的意图。"
  },
  {
   "name": "自动化决策",
   "topic": "算法与AI合规",
   "desc": "保证透明与结果公平公正，提供关闭选项与不针对个人特征的选项，不得实施不合理差别待遇。"
  },
  {
   "name": "训练数据合法来源",
   "topic": "算法与AI合规",
   "desc": "来源合法、尊重知识产权、涉及个人信息须取得同意，提升数据质量与真实性。"
  },
  {
   "name": "内容标识",
   "topic": "算法与AI合规",
   "desc": "AI 生成内容添加显式与隐式标识，深度合成服务须核验使用者身份。"
  },
  {
   "name": "应用备案",
   "topic": "移动应用合规",
   "desc": "App 主办者与分发平台备案、真实身份信息公示、分发平台审核与上架合规。"
  },
  {
   "name": "App 全生命周期管理",
   "topic": "移动应用合规",
   "desc": "需求设计、开发、上架、运营、下架各阶段的安全与个人信息保护要求，SDK 纳入管理。"
  },
  {
   "name": "权限动态申请",
   "topic": "移动应用合规",
   "desc": "运行时申请、最小权限、拒绝后不强制退出，不得频繁索权或捆绑授权。"
  },
  {
   "name": "平台规则",
   "topic": "平台合规",
   "desc": "平台服务协议与交易规则公开、公平，不得利用规则或数据优势实施不正当竞争。"
  }
 ],
